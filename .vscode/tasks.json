{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Database",
			"type": "shell",
			"command": "docker compose up -d",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Start API",
			"type": "shell",
			"command": "uv run fastapi dev main.py",
			"options": {
				"cwd": "${workspaceFolder}/api"
			},
			"problemMatcher": []
		},
		{
			"label": "Start Frontend",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"problemMatcher": []
		},
		{
			"label": "Start App",
			"dependsOn": ["Start API", "Start Frontend"],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Start Everything",
			"dependsOn": ["Start Database", "Start App"],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Stop Database",
			"type": "shell",
			"command": "docker compose down",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"type": "python",
			"problemMatcher": ["$python"],
			"label": "Python: Python Run"
		}
	]
}
