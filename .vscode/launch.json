{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Frontend: Chrome",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/frontend",
			"sourceMaps": true
		},
		{
			"name": "Frontend: React Router Server",
			"type": "node-terminal",
			"request": "launch",
			"cwd": "${workspaceFolder}/frontend"
		},
		{
			"name": "Backend: FastAPI",
			"type": "debugpy",
			"request": "attach",
			"connect": {
				"host": "127.0.0.1",
				"port": 5678
			},
			"justMyCode": true
		}
	],
	"compounds": [
		{
			"name": "Debug Fullstack Application",
			"configurations": [
				"Frontend: Chrome",
				"Frontend: React Router Server",
				"Backend: FastAPI"
			],
			"stopAll": true
		},
		{
			"name": "Debug Fullstack Frontend",
			"configurations": ["Frontend: Chrome", "Frontend: React Router Server"],
			"stopAll": true
		}
	]
}
